; Independent visual study. No dependency on the Space Trucking project.
config_version=5
[application]
config/name="Illustrated Hab — Room Study"
run/main_scene="res://room.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
[display]
window/size/viewport_width=1400
window/size/viewport_height=1000
window/size/window_width_override=1400
window/size/window_height_override=1000
window/stretch/mode="canvas_items"
[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
textures/default_filters/anisotropic_filtering_level=3
[physics]
common/physics_ticks_per_second=60
